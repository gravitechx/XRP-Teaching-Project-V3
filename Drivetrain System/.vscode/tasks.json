{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build robot code",
      "type": "shell",
      "command": "./gradlew build --console=plain",
      "options": {
        "env": {
          "JAVA_HOME": "${userHome}/wpilib/2027_alpha7/jdk"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulate robot",
      "type": "shell",
      "command": "./gradlew simulateJava",
      "options": {
        "env": {
          "JAVA_HOME": "${userHome}/wpilib/2027_alpha7/jdk"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
